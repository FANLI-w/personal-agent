{
  "name": "@research-agent-platform/research-skills",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }, "./import": { "types": "./dist/import.d.ts", "import": "./dist/import.js", "require": "./dist/import.cjs" },
    "./roles": { "types": "./dist/roles.d.ts", "import": "./dist/roles.js" },
    "./role-catalog": { "types": "./dist/role-catalog.d.ts", "import": "./dist/role-catalog.js" }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-skills.mjs && node ../../scripts/build-agent-roles.mjs && node ../../scripts/build-skill-import.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.check.json"
  },
  "dependencies": { "yaml": "2.8.3" }
}
