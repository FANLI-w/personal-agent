@@ -0,0 +1,45 @@
+// Copyright © 2026 Research Agent Platform contributors.
+// Licensed under the Apache License, Version 2.0.
+package webhook
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+	"github.com/openimsdk/open-im-server/v3/pkg/callbackstruct"
+	"github.com/openimsdk/open-im-server/v3/pkg/common/config"
+	"github.com/openimsdk/tools/mcontext"
+)
+
+func TestRAPTrustedSyncAndAsyncCallbackHeaders(t *testing.T) {
+	headers := make(chan http.Header, 2)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		headers <- r.Header.Clone()
+		w.Header().Set("Content-Type", "application/json")
+		w.Write([]byte(`{"actionCode":0,"nextCode":0,"errCode":0}`))
+	}))
+	defer server.Close()
+	ctx := mcontext.WithMustInfoCtx([]string{"synthetic-operation", "imAdmin", "Admin", "synthetic-connection"})
+	client := NewWebhookClient(server.URL)
+	req := &callbackstruct.CallbackBeforeSendSingleMsgReq{CommonCallbackReq:callbackstruct.CommonCallbackReq{CallbackCommand:"callbackBeforeSendSingleMsgCommand"}}
+	if err := client.SyncPost(ctx, req.GetCallbackCommand(), req, &callbackstruct.CallbackBeforeSendSingleMsgResp{}, &config.BeforeConfig{Timeout:2}); err != nil { t.Fatal(err) }
+	client.AsyncPost(ctx, req.GetCallbackCommand(), req, &callbackstruct.CallbackBeforeSendSingleMsgResp{}, &config.AfterConfig{Enable:true,Timeout:2})
+	for i:=0;i<2;i++ { select {
+	case header := <-headers:
+		if header.Get("X-RAP-OpenIM-Operator")!="imAdmin" || header.Get("X-RAP-OpenIM-Platform")!="Admin" || header.Get("X-RAP-OpenIM-Policy")!="rap-auth-v1" { t.Fatal(header) }
+	case <-time.After(3*time.Second): t.Fatal("callback did not arrive")
+	} }
+}
+
+func TestRAPWebhookNetworkFailureRedactsCallbackKey(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter,r *http.Request) {}))
+	url := server.URL; server.Close()
+	key := strings.Repeat("a",64)
+	client := NewWebhookClient(url+"/callback/"+key)
+	ctx := mcontext.WithMustInfoCtx([]string{"synthetic-operation", "imAdmin", "Admin", "synthetic-connection"})
+	req := &callbackstruct.CallbackBeforeSendSingleMsgReq{CommonCallbackReq:callbackstruct.CommonCallbackReq{CallbackCommand:"callbackBeforeSendSingleMsgCommand"}}
+	err := client.SyncPost(ctx,req.GetCallbackCommand(),req,&callbackstruct.CallbackBeforeSendSingleMsgResp{},&config.BeforeConfig{Timeout:1})
+	if err==nil || strings.Contains(err.Error(),key) || strings.Contains(err.Error(),url) { t.Fatalf("unsafe error %v",err) }
+}
