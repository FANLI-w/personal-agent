+package msggateway
+
+import (
+	"testing"
+	"github.com/openimsdk/protocol/sdkws"
+	"github.com/openimsdk/tools/mcontext"
+)
+
+func TestRAPAuthenticatedMessageIdentity(t *testing.T) {
+	ctx := mcontext.WithMustInfoCtx([]string{"synthetic-operation", "user_A", "Web", "synthetic-connection"})
+	valid := sdkws.MsgData{SendID: "user_A", SenderPlatformID: 5, MsgFrom: 100, ContentType: 101}
+	if err := validateRAPMessage(ctx, &valid); err != nil { t.Fatal(err) }
+	cases := []sdkws.MsgData{valid, valid, valid, valid, valid}
+	cases[0].SendID = "user_B"
+	cases[1].SenderPlatformID = 10
+	cases[2].SenderPlatformID = 3
+	cases[3].MsgFrom = 200
+	cases[4].ContentType = 1501
+	for index := range cases { if err := validateRAPMessage(ctx, &cases[index]); err == nil { t.Fatalf("forged case %d accepted", index) } }
+	valid.ContentType = 110
+	if err := validateRAPMessage(ctx, &valid); err != nil { t.Fatal(err) }
+}
