# Documentation only: no implicit dotenv loading. Set in the process environment.
NODE_ENV=development
HOST=127.0.0.1
PORT=3100
APP_ORIGIN=http://127.0.0.1:4175
DATABASE_PATH=.runtime/platform.sqlite
BLOB_ROOT=.runtime/blobs
# Local synthetic-account CLI only; no default password is shipped.
TEST_CREDENTIALS_FILE=.runtime/test-credentials.json

# B3 opt-in. Set credential only in a private server process environment.
B3_AI_ENABLED=0
DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY is required for real calls; no value is shipped.
# DEEPSEEK_BASE_URL is optional; unset uses the official provider endpoint.

# Public GitHub catalog facts/discovery, first run then daily Asia/Shanghai 00:00.
# No model credential required; reviewed revisions and private Skills stay separate.
GITHUB_CATALOG_SYNC=0
# Optional absolute path to an operator-owned GitHub token file; never a client key.
# GITHUB_CATALOG_TOKEN_FILE=/run/secrets/github-catalog
